{
  "name": "@frontmind/module-content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "zod": "4.1.12",
    "mdast-util-from-markdown": "^2.0.2",
    "react": "19.2.1",
    "lucide-react": "0.453.0",
    "drizzle-orm": "0.45.2",
    "mysql2": "3.20.0",
    "@frontmind/module-ui": "workspace:*",
    "express": "^4.21.2",
    "@frontmind/module-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "typescript": "5.9.3",
    "@types/react": "^19.2.1",
    "vitest": "2.1.9",
    "@types/express": "^4.17.21"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": "./dist/client/ContentProductionWorkspace.js",
    "./contracts/*": "./dist/contracts/*.js",
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client/*": "./dist/client/*.js"
  }
}
