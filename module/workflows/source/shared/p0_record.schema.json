{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.local/schemas/p0_record.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "pack_id", "source_pack_version", "pack_version", "route", "created_at", "paths"],
  "properties": {
    "schema_version": {"const": "4.11"},
    "artifact_type": {"const": "frontmind_p0_record"},
    "pack_id": {"type": "string", "pattern": "^rp_[a-f0-9]{16}$"},
    "source_pack_version": {"type": "integer", "minimum": 1},
    "pack_version": {"type": "integer", "minimum": 2},
    "route": {"enum": ["create", "import"]},
    "p0_revision": {"type": ["integer", "null"], "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "paths": {"type": "object"}
  }
}
