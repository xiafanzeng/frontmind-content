{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmind.local/schemas/core_positioning_decision.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "job_id", "directions_revision", "decision_source", "primary", "secondary", "custom_direction", "decided_at"],
  "properties": {
    "schema_version": {"const": "4.11"},
    "artifact_type": {"const": "frontmind_core_positioning_decision"},
    "job_id": {"type": "string", "minLength": 1},
    "directions_revision": {"type": "integer", "minimum": 0},
    "decision_source": {"enum": ["user_choice", "single_clear", "user_custom"]},
    "primary": {"enum": ["direction_1", "direction_2", "direction_3", "custom"]},
    "secondary": {"type": ["string", "null"], "enum": [null, "direction_1", "direction_2", "direction_3"]},
    "custom_direction": {"type": ["string", "null"]},
    "decided_at": {"type": "string", "format": "date-time"}
  }
}
