{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "rootDir": "module",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": [
    "module/contracts/**/*.ts",
    "module/server/**/*.ts",
    "module/client/**/*.tsx"
  ],
  "exclude": [
    "module/workflows/**"
  ]
}
